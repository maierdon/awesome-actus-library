@startuml model_comparison
skinparam style strictuml

title Model Comparison: Short-Rate Models

package "Equilibrium Models" #LightBlue {

    class Vasicek <<Equilibrium>> {
        **SDE:** dr = a(b-r)dt + σ dW
        ----
        **Parameters:**
        r₀: initial rate
        a: mean-reversion speed
        b: long-term mean
        σ: volatility
        ----
        **Properties:**
        ✓ Mean reversion
        ✓ Closed-form ZCB
        ✓ Fast simulation
        ✗ Negative rates possible
        ✗ No curve fitting
    }

    class CIR <<Equilibrium>> {
        **SDE:** dr = a(b-r)dt + σ√r dW
        ----
        **Parameters:**
        r₀: initial rate (≥ 0)
        a: mean-reversion speed
        b: long-term mean (≥ 0)
        σ: volatility
        ----
        **Properties:**
        ✓ Non-negative (Feller condition)
        ✓ Mean reversion
        ✓ Closed-form ZCB
        ✗ Feller condition: 2ab ≥ σ²
        ✗ No curve fitting
    }

    note bottom of Vasicek
      **Use cases:**
      - Teaching & benchmarking
      - Fast stress tests
      - Historical analysis
    end note

    note bottom of CIR
      **Use cases:**
      - Long-horizon scenarios
      - When r ≥ 0 is required
      - Regulatory-style modeling
    end note
}

package "No-Arbitrage Models" #LightGreen {

    class HoLee <<No-Arbitrage>> {
        **SDE:** dr = θ(t)dt + σ dW
        ----
        **Parameters:**
        r₀: initial rate
        σ: volatility
        calibrator: CurveCalibrator
        ----
        **θ(t):** dF(0,t)/dt + σ² t
        ----
        **Properties:**
        ✓ Exact curve fitting
        ✓ Analytical ZCB pricing
        ✗ No mean reversion
        ✗ Negative rates possible
        ✗ Drift issues for long horizons
    }

    class HullWhite <<No-Arbitrage>> {
        **SDE:** dr = (θ(t) - a r)dt + σ dW
        ----
        **Parameters:**
        r₀: initial rate
        a: mean-reversion speed
        σ: volatility
        calibrator: CurveCalibrator
        ----
        **θ(t):** dF/dt + aF + (σ²/2a)(1 - e^{-2at})
        ----
        **Properties:**
        ✓ Exact curve fitting
        ✓ Mean reversion
        ✓ Industry standard
        ✗ Negative rates possible
        ✗ One-factor limitation
    }

    note bottom of HoLee
      **Use cases:**
      - Short-term pricing
      - Pedagogical comparisons
      - Simple derivatives
    end note

    note bottom of HullWhite
      **Use cases:**
      - ALM / pension funds
      - Risk analytics
      - Industry benchmark
      - Interest-rate derivatives pricing
    end note
}

' Inheritance hierarchy
abstract class ShortRateModel {
    + simulate(T, M, I): SimulationResult
    + zcb_price(t, T, r_t): float
}

ShortRateModel <|-- Vasicek
ShortRateModel <|-- CIR
ShortRateModel <|-- HoLee
ShortRateModel <|-- HullWhite

' Calibrator dependency
class CurveCalibrator #LightYellow {
    spot_rate(t)
    forward_rate(t)
    forward_rate_slope(t)
    zcb_price(t)
}

HoLee --> CurveCalibrator : requires
HullWhite --> CurveCalibrator : requires

note as Legend
  **Legend:**
  ✓ advantage / strength
  ✗ drawback / limitation

  **ALM recommendation:**
  Hull–White (industry standard)
end note

@enduml
