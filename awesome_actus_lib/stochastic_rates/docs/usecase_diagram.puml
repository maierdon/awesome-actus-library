@startuml usecase_diagram
skinparam style strictuml
skinparam actorStyle awesome

title Use-Case Diagram: Stochastic Rates Module

left to right direction

actor "Quantitative\nAnalyst" as QA
actor "Risk Manager" as RM
actor "Developer" as Dev
actor "Student/\nResearcher" as Student

rectangle "Stochastic Rates Module" {

    usecase "Calibrate\nmarket curve" as UC1
    usecase "Instantiate\nshort-rate model" as UC2
    usecase "Monte Carlo\nsimulation" as UC3
    usecase "Validate\nmodel" as UC4
    usecase "Generate ACTUS\nscenarios" as UC5
    usecase "List available\nmodels" as UC6
    usecase "Statistical\nanalysis" as UC7
    usecase "Convergence\nanalysis" as UC8

    ' Relationships
    UC2 ..> UC1 : <<include>>\n(for HoLee/HullWhite)
    UC3 ..> UC2 : <<include>>
    UC5 ..> UC3 : <<include>>
    UC4 ..> UC3 : <<include>>
    UC7 ..> UC3 : <<include>>
    UC8 ..> UC7 : <<extend>>
}

rectangle "awesome_actus_lib" #LightGray {
    usecase "Create\nportfolio" as UC_P1
    usecase "Generate\nevents" as UC_P2
    usecase "Analyze\ncashflows" as UC_P3
}

' Actor links
QA --> UC1
QA --> UC2
QA --> UC3
QA --> UC5

RM --> UC5
RM --> UC7
RM --> UC_P3

Dev --> UC6
Dev --> UC4
Dev --> UC8

Student --> UC6
Student --> UC4
Student --> UC7

' Integration
UC5 --> UC_P2 : provides\nReferenceIndex
UC_P1 --> UC_P2 : defines
UC_P2 --> UC_P3 : enables

note right of UC1
  **Input:**
  - ZCB prices or
  - Spot rates

  **Output:**
  CurveCalibrator
end note

note right of UC3
  **Parameters:**
  - T: horizon
  - M: time steps
  - I: number of paths

  **Output:**
  SimulationResult
end note

note right of UC5
  **Converts:**
  NumPy paths →
  ACTUS ReferenceIndex

  **Frequencies:**
  D, W, M, Q, Y
end note

note bottom of UC4
  Comparison:
  Monte Carlo vs.
  analytical ZCB prices
end note

@enduml
